# ==============================================================================
# LED Sign Configuration
# ==============================================================================

# --- Google Gemini AI Media Generation ---
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use for generating 64x20 pixel-art GIFs and images
GEMINI_MODEL=gemini-3.8-flash

# Default media format: "gif" (recommended for fast BLE transfer & smooth looping) or "image"
GEMINI_DEFAULT_MODE=gif

# --- OpenAI / ChatGPT AI Media Generation ---
# Get your OpenAI API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server & Hardware Network Configuration ---
# LED_SIGN_HOST=127.0.0.1
# LED_SIGN_PORT=8000
# LED_SIGN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional Google Calendar Automation ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_PATH=token.json
