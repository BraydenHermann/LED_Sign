# Google OAuth Configuration (Optional for local dev)
# If GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are omitted, the app will fallback
# to using server/credentials.json for backward compatibility on localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_TOKEN_PATH=

# Fallback calendar display name (used if identity cannot be determined from OAuth)
CALENDAR_DISPLAY_NAME=

# Local backend/network configuration
# Keep localhost unless LAN access is intentionally required.
LED_SIGN_HOST=127.0.0.1

# Comma-separated origins allowed to access the backend.
# Leave blank to use the application's secure localhost defaults.
LED_SIGN_CORS_ORIGINS=
